# Copy to .env and fill in real values. Never commit the actual .env file.

ENVIRONMENT=development
DEBUG=true

DATABASE_URL=sqlite:///./nexora.db
# Postgres example for staging/prod:
# DATABASE_URL=postgresql+psycopg2://user:password@host:5432/nexora

SECRET_KEY=replace-with-a-long-random-value
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

ALLOWED_ORIGINS=["http://localhost:3000"]
