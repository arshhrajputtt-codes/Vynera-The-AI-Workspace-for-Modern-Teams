# Copy to .env and fill in real values. Never commit the actual .env file.

ENVIRONMENT=development
DEBUG=true

# Needs the pgvector extension available (most managed Postgres offers it).
DATABASE_URL=postgresql+psycopg://nexora:nexora@localhost:5432/nexora_core

# MUST match identity-service's SECRET_KEY/ALGORITHM exactly — this service
# verifies the same tokens without calling identity-service on every request.
SECRET_KEY=replace-with-a-long-random-value
ALGORITHM=HS256

IDENTITY_SERVICE_URL=http://localhost:8000

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# "ollama" = free, runs on your machine, no key needed (default).
# "anthropic" = paid, needs ANTHROPIC_API_KEY, much better quality.
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
LOCAL_EMBEDDING_MODEL=all-MiniLM-L6-v2

# "local" = free, runs on your machine, no key needed (default).
# "openai" = paid, needs OPENAI_API_KEY, better quality — switch to this
# once you have OpenAI billing set up.
EMBEDDING_PROVIDER=local

# 384 for the local model, 1536 if you switch EMBEDDING_PROVIDER to openai.
EMBEDDING_DIMENSIONS=384

CHUNK_SIZE_TOKENS=500
CHUNK_OVERLAP_TOKENS=50
TOP_K_CHUNKS=5

ALLOWED_ORIGINS=["http://localhost:3000"]
